@@ -0,0 +1,26 @@
+package com.olaysco.capacitorwhisper;
+
+import java.io.File;
+import java.io.IOException;
+import java.net.URI;
+
+/** Resolve downloaded checkpoints before attempting bundled asset lookup. */
+final class WhisperModelFile {
+    private WhisperModelFile() {}
+
+    static File downloaded(String model) throws IOException {
+        if (model == null || model.isEmpty()) return null;
+        final File file;
+        try {
+            file = model.startsWith("file:") ? new File(URI.create(model)) : new File(model);
+        } catch (IllegalArgumentException error) {
+            throw new IOException("Invalid model file URI", error);
+        }
+        // Bare model names keep the plugin's existing bundled-assets behavior.
+        if (!file.isAbsolute()) return null;
+        if (!file.isFile() || !file.canRead() || file.length() == 0) {
+            throw new IOException("Downloaded model is missing, empty or unreadable: " + file);
+        }
+        return file;
+    }
+}
