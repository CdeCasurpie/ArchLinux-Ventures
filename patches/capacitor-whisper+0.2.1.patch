@@ -0,0 +1,39 @@
+package com.olaysco.capacitorwhisper;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.file.Files;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import static org.junit.Assert.*;
+
+public class WhisperModelFileTest {
+    @Rule public TemporaryFolder temporary = new TemporaryFolder();
+
+    @Test public void opensDownloadedAbsolutePathWithoutLookingInAssets() throws Exception {
+        File model = temporary.newFile("ggml-tiny-q5_1.bin");
+        Files.write(model.toPath(), new byte[]{1, 2, 3});
+        assertEquals(model, WhisperModelFile.downloaded(model.getAbsolutePath()));
+        assertEquals(model, WhisperModelFile.downloaded(model.toURI().toString()));
+    }
+
+    @Test public void namedModelsStillUseBundledAssets() throws Exception {
+        assertNull(WhisperModelFile.downloaded("ggml-tiny-q5_1"));
+        assertNull(WhisperModelFile.downloaded(null));
+    }
+
+    @Test public void deletedDownloadedModelDoesNotFallBackToAssets() throws Exception {
+        File model = temporary.newFile("ggml-tiny-q5_1.bin");
+        Files.write(model.toPath(), new byte[]{1});
+        assertNotNull(WhisperModelFile.downloaded(model.getAbsolutePath()));
+        assertTrue(model.delete());
+        assertThrows(IOException.class, () -> WhisperModelFile.downloaded(model.getAbsolutePath()));
+    }
+
+    @Test public void rejectsEmptyFilesAndDirectories() throws Exception {
+        File empty = temporary.newFile("empty.bin");
+        assertThrows(IOException.class, () -> WhisperModelFile.downloaded(empty.getAbsolutePath()));
+        assertThrows(IOException.class, () -> WhisperModelFile.downloaded(temporary.getRoot().getAbsolutePath()));
+    }
+}
